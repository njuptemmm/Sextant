# Copy to .env and fill in what you need. Everything here is optional:
# Sextant runs without an LLM and without any API key.

# --- LLM (OpenAI-compatible) -------------------------------------------------
# Any provider exposing /chat/completions works (OpenAI, DeepSeek, Qwen,
# Moonshot, vLLM, Ollama's OpenAI endpoint, ...).
# Leave these empty to run in keyword-only mode.
SEXTANT_LLM_BASE_URL=
SEXTANT_LLM_API_KEY=
SEXTANT_LLM_MODEL=
# Records per enrichment request, and its completion budget.
# Reasoning models charge their chain-of-thought to the same max_tokens
# allowance, so a budget that is too small returns empty content.
# Lower the batch size (not just the tokens) if you see "输出被截断" in the logs.
SEXTANT_LLM_ENRICH_BATCH_SIZE=10
SEXTANT_LLM_ENRICH_MAX_TOKENS=8000

# --- Integrated report (on-demand job) ---------------------------------------
# The report is NOT part of the retrieval pipeline. It starts when the user
# clicks "生成调研报告" (or calls the generate_report MCP tool), and it needs an
# LLM. Set SEXTANT_REPORT_ENABLED=0 to hide the entry point. Top-N papers by
# ranking enter the report.
SEXTANT_REPORT_ENABLED=1
SEXTANT_REPORT_MAX_PAPERS=20
# Papers analysed per request, and that request's completion budget.
SEXTANT_LLM_REPORT_BATCH_SIZE=5
SEXTANT_LLM_REPORT_MAX_TOKENS=8000
# The single synthesis call writes the executive summary, six bilingual
# sections and the subtheme grouping; it needs a larger timeout than retrieval.
# On a reasoning model the chain of thought is billed to this same budget.
SEXTANT_LLM_REPORT_SYNTHESIS_MAX_TOKENS=16000
SEXTANT_LLM_REPORT_TIMEOUT=180

# --- Retrieval ---------------------------------------------------------------
# Where topic workspaces are written (default: ./workspace inside the repo).
# In Docker this is mounted as a volume, so leave it at /app/workspace.
SEXTANT_WORKSPACE_ROOT=
# Records requested per source per query (1-50).
SEXTANT_MAX_RESULTS_PER_SOURCE=20
# How many sources may be queried in parallel.
SEXTANT_SOURCE_CONCURRENCY=4

# --- Server ------------------------------------------------------------------
SEXTANT_HOST=127.0.0.1
SEXTANT_PORT=8000
SEXTANT_MCP_PORT=8001

# Optional: raises Semantic Scholar reliability; without it the source is
# skipped automatically.
# SEMANTIC_SCHOLAR_API_KEY=
